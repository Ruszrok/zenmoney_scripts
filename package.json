{
  "name": "zenmoney-scripts",
  "type": "module",
  "scripts": {
    "submit": "bun run src/submit.ts",
    "accounts": "bun run src/submit.ts --list-accounts",
    "categories": "bun run src/submit.ts --list-categories",
    "lint": "biome check src config.ts",
    "format": "biome check --write src config.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./src/*.test.ts",
    "check": "bun run typecheck && bun run test",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "bun-types": "^1.3.9",
    "typescript": "^6.0.3"
  }
}
