{
  "name": "zenmoney-scripts",
  "type": "module",
  "packageManager": "bun@1.3.9",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "submit": "bun run src/submit.ts",
    "accounts": "bun run src/submit.ts --list-accounts",
    "categories": "bun run src/submit.ts --list-categories",
    "lint": "biome check src",
    "format": "biome check --write src",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./src/*.test.ts",
    "detect-log": "python3 scripts/detect_zenmoney_log.py",
    "finance": "python3 -m finance",
    "test:py": "python3 -m unittest discover -s finance/tests -t .",
    "check": "bun run typecheck && bun run test && bun run test:py",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "bun-types": "^1.3.9",
    "typescript": "^6.0.3"
  }
}
